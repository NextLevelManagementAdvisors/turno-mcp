# ── Transport ──────────────────────────────────────────────────────────────
# stdio = single-user local mode (default; reads TURNO_API_TOKEN + TURNO_PARTNER_ID)
# http  = multi-tenant hosted mode behind Express + StreamableHTTP
TRANSPORT=stdio

# ── HTTP mode ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3007
# Public hostname, used in the enrollment success page (displays a ready-to-paste URL).
TURNO_PUBLIC_HOST=turno.nlma.io

# AES-256-GCM root key (32+ chars). Required in http mode; HKDF-derived per-secret.
# Generate with:  openssl rand -hex 32
TURNO_ENCRYPTION_KEY=

# Where per-tenant state lives (tenants.json + future OAuth cache).
TURNO_DATA_DIR=./data
TURNO_TENANTS_FILE=./data/tenants.json

# Allow HTML enrollment at /enroll (set false if you want enrollment disabled).
ENROLL_ENABLED=true

# ── Turno API ──────────────────────────────────────────────────────────────
# Default production base; override to https://sandbox.turnoverbnb.com/v2 for testing.
TURNO_BASE_URL=https://api.turnoverbnb.com/v2

# ── stdio mode credentials (ignored when TRANSPORT=http) ───────────────────
TURNO_API_TOKEN=
TURNO_PARTNER_ID=
