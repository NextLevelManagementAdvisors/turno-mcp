# ── Transport ──────────────────────────────────────────────────────────────
# stdio = single-user local mode (default; reads TURNO_API_TOKEN + TURNO_PARTNER_ID)
# http  = multi-tenant hosted mode behind Express + StreamableHTTP
TRANSPORT=stdio

# ── HTTP mode ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3009
# Public hostname used in the enrollment success page and landing page URL.
TURNO_PUBLIC_HOST=turno.nlma.io

# HKDF root key (32+ chars). Used for:
#   (a) HMAC-SHA256 signing of the bearer JWTs we issue
#   (b) AES-256-GCM encryption of the Turno Secret Key *embedded* inside those JWTs
# Generate with:  openssl rand -hex 32
# Losing this rotates every active bearer — users will need to re-enroll once.
# There is no tenant store on disk; the encryption key is the only persistent secret.
TURNO_ENCRYPTION_KEY=

# Allow HTML enrollment at /enroll (set false if you want enrollment disabled).
ENROLL_ENABLED=true

# ── Turno API ──────────────────────────────────────────────────────────────
# Default production base; override to https://sandbox.turnoverbnb.com/v2 for testing.
TURNO_BASE_URL=https://api.turnoverbnb.com/v2

# ── stdio mode credentials (ignored when TRANSPORT=http) ───────────────────
TURNO_API_TOKEN=
TURNO_PARTNER_ID=
